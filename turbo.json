{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": ["eslint-rules/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test:e2e": {
      "dependsOn": ["^build"],
      "cache": false,
      "passThroughEnv": [
        "DATABASE_URL",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "INTERNAL_API_SECRET",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "API_BASE_URL",
        "NEXT_PUBLIC_API_BASE_URL",
        "STORAGE_DIR",
        "PORT",
        "PRISMA_USER_CONSENT_FOR_DANGEROUS_AI_ACTION",
        "SEED_ADMIN_EMAIL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "NEXTAUTH_URL",
        "NEXTAUTH_SECRET",
        "INTERNAL_API_SECRET",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "API_BASE_URL",
        "NEXT_PUBLIC_API_BASE_URL",
        "STORAGE_DIR",
        "PORT"
      ]
    }
  }
}
