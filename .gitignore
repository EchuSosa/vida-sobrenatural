# Dependencies
node_modules/

# Build outputs
dist/
build/
.next/
# H-78/D124: distDir propio de cada webServer de e2e (apps/web,
# apps/backoffice/playwright.config.ts) — Next enlaza el lock de "una sola
# instancia" al distDir, no al puerto, así que la app de desarrollo y las
# de e2e necesitan distDir distintos para poder correr a la vez.
.next-e2e*/
out/

# Turborepo
.turbo/

# Env files (each app's own .gitignore also covers this)
.env
.env.*
!.env.example
# H-98: .env.test/.env.e2e (integración y e2e de apps/api) no se versionan —
# mismo criterio que .env — pero sus .example sí, para que un clon nuevo
# pueda arrancar las dos suites sin adivinar las claves.
!.env.test.example
!.env.e2e.example

# OS / editor
.DS_Store

# Logs
*.log

# TypeScript incremental build info
*.tsbuildinfo

# Prisma's auto-generated AI-agent skill docs (regenerated on `pnpm install`, not project content)
apps/api/.claude/
apps/api/.cursor/
apps/api/.windsurf/
apps/api/.agents/
apps/api/.devin/
apps/api/skills-lock.json

# Encargos que deja el chat de claude.ai para /brief (no se versionan)
BRIEF*.md
BRIEF-ESTADO.md

# Worktrees de los lotes A–D de la 004 (scripts/lote-worktree.sh) — cada uno es
# un checkout aparte con sus propias bases y puertos; no se versionan.
.worktrees/
