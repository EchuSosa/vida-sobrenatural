{
  "name": "vida-sobrenatural-app",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "check:decisiones": "node scripts/chequear-decisiones-duplicadas.mjs",
    "check:imports-prohibidos": "node scripts/chequear-imports-prohibidos.mjs",
    "check": "turbo run lint typecheck test --continue && pnpm run check:decisiones && pnpm run check:imports-prohibidos"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4",
    "turbo": "^2.10.13"
  }
}
