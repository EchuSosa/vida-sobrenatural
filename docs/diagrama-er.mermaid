erDiagram
    SEDE ||--o{ PERSONA : "congrega"
    SEDE ||--o{ GRUPO : "ubica"
    SEDE ||--o{ EVENTO : "organiza"

    PERSONA |o--o{ PERSONA : "da de alta (Admin, opcional - D143)"

    CURSO ||--o{ GRUPO : "instancia"

    GRUPO ||--o{ ITEM_CRONOGRAMA : "tiene su cronograma (opcional, liberacion programada - D161)"
    GRUPO ||--o{ CONTENIDO : "contiene (opcional)"
    ITEM_CRONOGRAMA ||--o| CONTENIDO : "libera (uno por semana)"
    CONTENIDO ||--o{ ARCHIVO_CONTENIDO : "adjunta (privados - D168)"
    CONTENIDO ||--o{ ENLACE_CONTENIDO : "enlaza"

    GRUPO ||--o{ ENCUENTRO : "registra reuniones/sesiones (aplica a cualquier modalidad)"

    PERSONA ||--o{ INSCRIPCION : "se inscribe como alumno"
    GRUPO ||--o{ INSCRIPCION : "recibe inscriptos"
    INSCRIPCION ||--o{ ASISTENCIA : "registra por encuentro"
    ENCUENTRO ||--o{ ASISTENCIA : "corresponde a"

    PERSONA ||--o{ LIDERAZGO : "lidera / disciplina"
    GRUPO ||--o{ LIDERAZGO : "es liderado por"

    MINISTERIO ||--o{ CELULA : "contiene"
    PERSONA ||--o{ POSTULACION : "postula (historial)"
    MINISTERIO ||--o{ POSTULACION : "recibe postulaciones"
    CELULA ||--o{ POSTULACION : "asigna (opcional)"

    PERSONA ||--o{ SOLICITUD_BAUTISMO : "solicita"
    PERSONA ||--o{ SOLICITUD_DISCIPULADO : "solicita"
    PERSONA ||--o{ SOLICITUD_VIDA_SERVICIO : "solicita"
    GRUPO |o--o{ SOLICITUD_VIDA_SERVICIO : "edicion pedida (null = la proxima - D163)"
    SOLICITUD_DISCIPULADO |o--o| INSCRIPCION : "origina (Vida Nueva)"
    SOLICITUD_VIDA_SERVICIO |o--o| INSCRIPCION : "origina (Vida de Servicio)"
    SOLICITUD_BAUTISMO |o--o| INSCRIPCION_EVENTO : "asignada a un Evento de bautismo - D181"
    PERSONA ||--o{ INSCRIPCION_EVENTO : "se inscribe"
    EVENTO ||--o{ INSCRIPCION_EVENTO : "recibe inscriptos"
    INSCRIPCION_EVENTO ||--o{ PAGO : "registra pagos (si el evento tiene costo; uno pendiente a la vez)"

    PERSONA ||--o{ SUSCRIPCION_NOTIFICACION : "tiene dispositivos suscriptos (tanda siguiente - D149)"
    PERSONA ||--o{ NOTIFICACION : "crea (si es manual, rol Admin)"
    PERSONA ||--o{ NOTIFICACION : "es el alcance de (opcional, ej. solicitud_actualizada)"
    GRUPO ||--o{ NOTIFICACION : "es el alcance de (opcional)"
    MINISTERIO ||--o{ NOTIFICACION : "es el alcance de (opcional)"
    EVENTO ||--o{ NOTIFICACION : "es el alcance de (opcional)"
    NOTIFICACION ||--o{ ENTREGA_NOTIFICACION : "se entrega por destinatario y canal"
    PERSONA ||--o{ ENTREGA_NOTIFICACION : "recibe"

    PERSONA ||--o{ BLOQUEO_DISPONIBILIDAD : "bloquea su disponibilidad en fechas"

    PERSONA ||--o{ RELACION_FAMILIAR : "tiene familiares vinculados"

    PERSONA ||--o{ DECLARACION_HISTORIAL : "declara Ya lo hice - D154"
    PERSONA ||--o{ COMPLETITUD_MANUAL : "tiene etapas registradas por la iglesia - D153"
    DECLARACION_HISTORIAL |o--o| COMPLETITUD_MANUAL : "al confirmarse crea"

    PERSONA |o--o{ COMENTARIO_APP : "envia (opcional, si tenia sesion)"

    SEDE {
        string id
        string nombre
        string direccion
        string whatsapp_secretaria "opcional (D218), celular argentino normalizado 549..."
        boolean activo
    }
    PERSONA {
        string id
        string nombre
        string apellido
        string genero
        string email "opcional (D145), unico entre quienes lo tienen, normalizado"
        string dni "opcional (D215), solo lo carga el Admin, 7 u 8 digitos, unico"
        string telefono_normalizado "solo digitos, aviso de duplicado - D145"
        string foto_url "opcional, URL de la foto de perfil de Google al registrarse (D87)"
        string telefono "input estructurado: codigo de pais + numero, ver D90"
        string direccion
        date fecha_nacimiento
        string sede_id FK
        string estado "activa o pendiente_tutor"
        string rol "roles acumulativos; apto_ministerio y miembro_ministerio son roles de estado (D159, D170)"
        date bautismo_habilitado_en "opcional, D147"
        string bautismo_habilitado_por FK "admin"
        string tutor_nombre "solo si es menor de edad"
        string tutor_apellido "solo si es menor de edad"
        string tutor_telefono "solo si es menor de edad"
        boolean disponible_discipulado "toggle manual, solo relevante si tiene el rol Discipulador"
        string estado_civil "soltero_a, casado_a, en_concubinato, viudo_a, divorciado_a, separado_a"
        string profesion "categoria predefinida, ver D90 (Otro incluye texto libre)"
        string profesion_detalle "opcional, solo si profesion=otro"
        int congrega_desde "anio en que empezo a venir - D214; el tiempo se calcula al mostrarlo"
        string idioma_preferido "es (default), pt o en - D84"
        string tema_preferido "claro (default), oscuro o sistema - D106"
        string origen_alta "autorregistro o admin - D97"
        string alta_por FK "Persona que hizo el alta, null si autorregistro"
        date fecha_consentimiento "D78"
        string consentimiento_origen "app o presencial"
    }
    CURSO {
        string id
        string nombre
        string tipo "individual o grupal"
        string modalidad "liberacion_programada o seguimiento_por_encuentros"
        string categoria "ej. vida_nueva, vida_de_servicio"
        string prerequisito_categoria "opcional, ej. Vida de Servicio requiere categoria vida_nueva"
        string descripcion "opcional - D212"
        boolean activo
        date eliminado_en "D119"
        string eliminado_por FK
    }
    GRUPO {
        string id
        string curso_id FK
        string sede_id FK
        string nombre "obligatorio en Vida de Servicio (edicion)"
        date fecha_inicio
        boolean inscripcion_abierta "Vida de Servicio"
        string estado "en_curso o finalizado"
        boolean propuesta_finalizacion "true = el Lider propuso finalizar, falta confirmacion del Admin"
    }
    ITEM_CRONOGRAMA {
        string id
        string grupo_id FK
        int numero_semana "1..52"
        date fecha_liberacion
        date eliminado_en "borrado logico"
    }
    CONTENIDO {
        string id
        string grupo_id FK
        string item_cronograma_id FK "unico"
        string titulo
        string texto "opcional"
        string cargado_por FK
        date liberacion_avisada_en "el aviso sale una sola vez - D162"
    }
    ARCHIVO_CONTENIDO {
        string id
        string contenido_id FK
        string ruta "area privada de StorageService"
        string nombre_original
        string mime_type "detectado por contenido"
        int tamanio_bytes
        string texto_alternativo "obligatorio si es imagen"
        date eliminado_en
    }
    ENLACE_CONTENIDO {
        string id
        string contenido_id FK
        string texto
        string url "https"
        date eliminado_en
    }
    INSCRIPCION {
        string id
        string persona_id FK
        string grupo_id FK
        date fecha_inscripcion
        string estado "activa, completada, dada_de_baja, abandono"
        string solicitud_id FK "Solicitud de Discipulado, o"
        string solicitud_vida_servicio_id FK "Solicitud de Vida de Servicio (exactamente una)"
        string baja_propuesta_tipo "dada_de_baja o abandono, solo Vida de Servicio - D158"
    }
    ASISTENCIA {
        string id
        string inscripcion_id FK
        string encuentro_id FK
        boolean presente
        string registrado_por FK "lider o admin"
    }
    LIDERAZGO {
        string id
        string persona_id FK
        string grupo_id FK
        string rol "lider o discipulador"
    }
    MINISTERIO {
        string id
        string nombre
        string descripcion
        boolean activo
        date eliminado_en "D119"
        string eliminado_por FK
    }
    CELULA {
        string id
        string ministerio_id FK
        string nombre
        boolean activo
        date eliminado_en "D119"
        string eliminado_por FK
    }
    POSTULACION {
        string id
        string persona_id FK
        string ministerio_id FK
        string celula_id FK "opcional"
        string estado "pendiente, aprobada, rechazada, inactiva, retirada - D171"
        date fecha
        string motivacion "opcional"
        string disponibilidad "opcional"
        string motivo_rechazo "interno - D176"
        string motivo_inactivacion "cambio_de_ministerio o baja - D174"
        string reemplazada_por FK "la aprobada que la reemplazo"
        string motivo_baja "interno"
        string revisado_por FK "admin"
        string creado_por FK "null = la propia Persona"
    }
    EVENTO {
        string id
        string sede_id FK
        string nombre
        string slug "URL publica unica del evento - D82"
        datetime inicio "con hora - D189"
        datetime fin "opcional"
        string lugar "opcional, default la direccion de la Sede - D190"
        string tipo "general o bautismo - D188"
        string descripcion
        string imagen_url "opcional, flyer del evento"
        string descripcion_imagen "obligatorio si hay imagen_url, texto alternativo - D83"
        string publico_objetivo "informativo, sin validacion del sistema"
        boolean requiere_inscripcion
        boolean requiere_aprobacion "solo aplica si requiere_inscripcion=true"
        string estado "publicado o cancelado"
        date eliminado_en "papelera - D119"
        int dias_anticipacion_recordatorio "opcional, null = no se envia recordatorio de inscripcion"
        int cupo "opcional, null = sin limite"
        boolean permite_lista_espera "solo aplica si cupo esta definido"
        float costo "opcional, null = evento gratuito"
        string instrucciones_pago "obligatorio si hay costo - D191"
    }
    SOLICITUD_BAUTISMO {
        string id
        string persona_id FK
        string estado "pendiente, aprobada, rechazada, retirada, realizada - D180"
        date fecha_solicitud
        string comentario "opcional, reemplaza fecha_deseada - D179"
        string motivo_rechazo "solo el equipo - D185"
        string inscripcion_evento_id FK "asignacion a un Evento de bautismo - D181"
        date realizada_en
        string revisado_por FK "admin"
        string creado_por FK "null = la propia Persona"
    }
    SOLICITUD_VIDA_SERVICIO {
        string id
        string persona_id FK
        string estado "pendiente, aprobada, rechazada, retirada"
        string grupo_id FK "edicion pedida, null = la proxima"
        string motivo_rechazo "solo Admin"
        string revisado_por FK "admin"
        string creado_por FK "null = la propia Persona"
    }
    DECLARACION_HISTORIAL {
        string id
        string persona_id FK
        string etapa "vida_nueva, vida_de_servicio, ministerio, bautismo"
        string estado "pendiente, confirmada, rechazada, retirada"
        string comentario "opcional"
        string motivo_rechazo "opcional, lo ve la Persona"
        string revisado_por FK "admin"
        string creado_por FK "null = la propia Persona"
    }
    SOLICITUD_DISCIPULADO {
        string id
        string persona_id FK
        string estado "pendiente, aprobada, rechazada"
        date fecha_solicitud
        string revisado_por FK "admin"
        string creado_por FK "null = la propia Persona"
    }
    INSCRIPCION_EVENTO {
        string id
        string persona_id FK
        string evento_id FK
        string estado "confirmada, pendiente, rechazada, lista_espera, cancelada"
        date fecha
        date en_lista_desde "orden de la lista de espera"
        string motivo_cancelacion "persona, admin o pago_rechazado - D192"
        string creado_por FK "null = la propia Persona"
    }
    PAGO {
        string id
        string inscripcion_evento_id FK
        float monto
        string medio_pago
        string comprobante_ruta "area privada, solo duena y quien verifica - D195"
        string estado "pendiente_verificacion, verificado, rechazado"
        date fecha_pago
        string motivo_rechazo "obligatorio si rechazado, lo ve la Persona"
        string creado_por FK "null = la Persona; si es el Admin nace verificado"
        string verificado_por FK "admin"
    }
    ENCUENTRO {
        string id
        string grupo_id FK
        date fecha
        string capitulos_vistos "opcional, aplica a cursos con libro fisico"
        string notas
    }
    SUSCRIPCION_NOTIFICACION {
        string id
        string persona_id FK
        string endpoint "datos de suscripcion push del dispositivo/navegador"
        boolean activo "false si el servicio push la informa como vencida"
        date fecha_creacion
    }
    NOTIFICACION {
        string id
        string tipo "manual o automatica"
        string prioridad "normal o importante - importante tambien va por email (D96)"
        string titulo "solo manual, max 80"
        string mensaje "solo manual, max 1000, texto plano"
        string alcance "todos, grupo, ministerio, evento o persona"
        string alcance_id FK "segun el valor de alcance; null si alcance=todos"
        string evento "solo automatica: nombre del CATALOGO_AVISOS; el disparador se deriva de ahi (D198)"
        json params "solo automatica: ids y datos no personales"
        string clave_idempotencia "opcional, unica"
        string entidad_relacionada_tipo "grupo, solicitud, postulacion, inscripcion_evento, etc (solo automatica)"
        string entidad_relacionada_id "id de la entidad que origino la notificacion (solo automatica)"
        string creado_por FK "admin, null si es automatica"
        date fecha_envio
    }
    ENTREGA_NOTIFICACION {
        string id
        string notificacion_id FK
        string persona_id FK
        string canal "app, push o email - D100"
        string estado "pendiente, enviada o fallida"
        int intentos
        date proximo_intento_en "solo email - D204"
        string ultimo_error "opcional, solo el tipo"
        date fecha_envio
        date leida_en "solo canal app, null = no leida"
    }
    BLOQUEO_DISPONIBILIDAD {
        string id
        string persona_id FK
        date fecha_inicio
        date fecha_fin
        string motivo "opcional, ej. vacaciones"
    }
    RELACION_FAMILIAR {
        string id
        string persona_id FK "sujeto de la relacion"
        string familiar_id FK "otra Persona - el vinculo se guarda una sola vez, la inversa se resuelve en codigo (D112)"
        string tipo_relacion "tutor, conyuge, hijo_a, padre_madre, hermano_a - D112"
    }
    COMPLETITUD_MANUAL {
        string id
        string persona_id FK
        string etapa "vida_nueva, vida_de_servicio, ministerio, bautismo - D153"
        string origen "declaracion o admin"
        string declaracion_id FK "solo si origen=declaracion"
        string nota "opcional, ej. hizo Vida Nueva en otra congregacion"
        string registrado_por FK "admin"
        date registrada_en
        date anulada_en "borrado logico; una vigente por Persona y etapa"
        string anulada_por FK
    }
    VIDEO_YOUTUBE {
        string id
        string youtube_id "id del video en YouTube, unico"
        string titulo
        string miniatura_url
        date fecha_publicacion
        date fecha_sincronizacion "ultima actualizacion por la tarea programada - D93"
    }
    COMENTARIO_APP {
        string id
        string persona_id FK "opcional"
        string tipo "problema o sugerencia - D102"
        string texto
        boolean acepta_contacto
        string pagina_origen
        string contacto_email "solo sin sesion y con acepta_contacto"
        string contacto_telefono "solo sin sesion y con acepta_contacto"
        string datos_tecnicos "navegador, ultimo requestId"
        string app "web o backoffice"
        string origen_huella "HMAC de la IP, nunca la IP - D211"
        date revisado_en
        string revisado_por FK "admin"
        date fecha
    }
    PALABRA_PROFETICA {
        string id
        int anio
        string titulo "ej. Fidelidad y crecimiento"
        string texto
        string url_video "YouTube, opcional - D121"
        boolean vigente "una sola vigente por vez - D109"
        string actualizado_por FK "admin"
        date fecha_actualizacion
    }
    LIBRO {
        string id
        string titulo
        string autor
        int anio
        string portada_url "opcional, subida por el Admin, publica - D110; placeholder si no hay"
        string portada_descripcion "obligatorio si hay portada_url, texto alternativo - D83"
        string descripcion "opcional"
        int orden
        boolean activo "soft delete - D37"
    }
