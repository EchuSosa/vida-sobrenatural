DATABASE_URL="postgresql://vidasobrenatural:vidasobrenatural_dev@localhost:5432/vidasobrenatural?schema=public"

# Puerto de esta API — 3333 (no 3000) para dejar el 3000 libre en el entorno local.
PORT=3333

# Debe ser el mismo valor en apps/web y apps/backoffice — firma/verifica el JWT de sesión de NextAuth.js.
NEXTAUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"

# Debe ser el mismo valor en apps/web y apps/backoffice — protege GET /personas/by-email (llamada servidor-a-servidor).
INTERNAL_API_SECRET="changeme-generate-with-openssl-rand-base64-32"

# Carpeta local donde StorageService guarda las portadas subidas (D110) — fuera del control de
# versiones, no durable entre despliegues hasta que exista hosting con almacenamiento persistente
# (D75, ver plan.md de specs/003-contenido-institucional).
STORAGE_DIR="./storage/portadas"

# Opcional — monitoreo de errores (D101, H-112). @sentry/nestjs ya está instalado y queda inerte
# sin DSN (Sentry.init no envía nada si dsn es undefined). Descomentar y completar con el DSN real
# recién cuando exista hosting con Sentry configurado — ver docs/10-stack-tecnico.md.
# SENTRY_DSN="https://changeme@oXXXXXX.ingest.sentry.io/XXXXXXX"
# SENTRY_ENVIRONMENT="production"

# spec 007 (D140) — EmailService por SMTP. En local, Mailpit (docker-compose.yml):
# los emails se ven en http://localhost:8025. La API NO arranca sin SMTP_HOST.
SMTP_HOST="localhost"
SMTP_PORT=1025
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_SEGURO="false"
EMAIL_REMITENTE="Vida Sobrenatural <no-responder@localhost>"

# spec 007 — firma los códigos de ingreso por email (HMAC). Cualquier valor largo y aleatorio.
CODIGO_INGRESO_SECRET="changeme-generate-with-openssl-rand-base64-32"

# spec 012 (D205) — URL pública de apps/web, para los enlaces de los emails de aviso.
WEB_URL="http://localhost:3001"

# spec 012 (D205) — "false" apaga las tareas programadas (recordatorios, vencimientos) en esta instancia.
TAREAS_PROGRAMADAS="true"

# spec 013 — a dónde llega el email de cada Comentario de la app (vacío = solo en el backoffice).
# EMAIL_COMENTARIOS_DESTINO=""
# spec 013 — URL del backoffice, para el enlace al comentario en ese email (vacía = sin enlace).
# BACKOFFICE_URL="http://localhost:3002"

# spec 014 (D223): "falso" para trabajar sin red (resuelve solo direcciones de prueba).
# Sin definir: Georef (apis.datos.gob.ar) y, si no encuentra, Nominatim (OpenStreetMap).
# GEOCODIFICADOR="falso"
# GEOCODIFICADOR_USER_AGENT="VidaSobrenatural/1.0 (contacto: secretaria@ejemplo.org)"
