DATABASE_URL="postgresql://vidasobrenatural:vidasobrenatural_dev@localhost:5432/vidasobrenatural?schema=public"

# Puerto de esta API — 3333 (no 3000) para dejar el 3000 libre en el entorno local.
PORT=3333

# Debe ser el mismo valor en apps/web y apps/backoffice — firma/verifica el JWT de sesión de NextAuth.js.
NEXTAUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"

# Debe ser el mismo valor en apps/web y apps/backoffice — protege GET /personas/by-email (llamada servidor-a-servidor).
INTERNAL_API_SECRET="changeme-generate-with-openssl-rand-base64-32"
