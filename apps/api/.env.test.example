# H-59/H-98: base propia de los tests de integración (test/global-setup.cjs
# la crea y migra sola si falta) — nunca la de desarrollo. Copiá este
# archivo a `.env.test` antes de correr `pnpm --filter api run test:e2e`
# (ver docs/11-setup-local.md).
DATABASE_URL="postgresql://vidasobrenatural:vidasobrenatural_dev@localhost:5432/vidasobrenatural_test?schema=public"

# No necesitan ser secretos reales — nunca se usan contra Google real, solo
# entre el proceso de test y la API que levanta para sí mismo.
NEXTAUTH_SECRET="test-secret"
INTERNAL_API_SECRET="test-internal"

# spec 007 — los tests reemplazan EmailService por EmailServiceFalso; esto solo
# hace falta para que el módulo SMTP arranque (nunca se envía nada).
SMTP_HOST="localhost"
SMTP_PORT=1025
CODIGO_INGRESO_SECRET="test-codigo"
WEB_URL="http://localhost:3001"
TAREAS_PROGRAMADAS="false"

# spec 014 (D223): sin red — el geocodificador falso (test/load-test-env.cjs también lo fuerza).
GEOCODIFICADOR="falso"
