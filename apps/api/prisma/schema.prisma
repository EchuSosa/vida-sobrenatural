// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  // Dentro de src/ para que tsc (rootDir: ./src en tsconfig.build.json) pueda
  // compilarlo junto con el resto del código de la app.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Fase de Bienvenida (specs/001-fase-bienvenida) ---
// Nombres de campo alineados con docs/04-dominio-entidades.md (Constitución, Principio II).
// Ninguna entidad se borra físicamente — ambas usan `activo` (Principio III).

model Sede {
  id                    String  @id @default(uuid())
  // Único "entre Sedes activas" es una regla de negocio (SedeService), no un
  // constraint de base de datos — ver data-model.md.
  nombre                String
  direccion             String
  contactoTelefono      String?
  contactoEmail         String?
  horarios              String
  descripcionBienvenida String?
  activo                Boolean @default(true)

  // D119 (revisión manual ronda 6, H-67/H-69): Inactivar y Eliminar son dos
  // acciones distintas. `activo` (arriba) sigue significando el estado del
  // negocio, sin tocar — `eliminadoEn`/`eliminadoPor` son la propia marca
  // de un borrado lógico (Principio III, nunca físico) que saca el
  // registro de TODAS las vistas normales (no solo "inactivas"), con su
  // fecha y responsable. `eliminadoPor` es una referencia lógica al id de
  // la Persona que eliminó, sin @relation de Prisma (mismo criterio que
  // `Persona.altaPor`).
  eliminadoEn  DateTime?
  eliminadoPor String?

  personas Persona[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sedes")
}

enum Genero {
  masculino
  femenino
}

enum EstadoCivil {
  soltero_a
  casado_a
  en_concubinato
  viudo_a
  divorciado_a
  separado_a
}

enum TiempoCongregacion {
  menos_6_meses
  de_6_meses_a_1_anio @map("6_meses_a_1_anio")
  de_1_a_3_anios      @map("1_a_3_anios")
  de_3_a_5_anios      @map("3_a_5_anios")
  mas_5_anios
}

enum EstadoPersona {
  activa
  pendiente_tutor
}

// --- Base Transversal (specs/002-base-transversal) ---

enum Idioma {
  es
}

enum TemaPreferido {
  claro
  oscuro
  sistema
}

// --- Fase de Bienvenida, actualización 2026-09-17 (D97, FR-013, FR-015) ---

enum OrigenConsentimiento {
  app
  presencial
}

enum OrigenAlta {
  autorregistro
  admin
}

enum Profesion {
  salud
  educacion
  tecnologia_ingenieria
  comercio_ventas
  oficios_construccion
  administracion_finanzas
  legal
  comunicacion_marketing
  arte_diseno
  servicios_gastronomia
  transporte
  estudiante
  ama_de_casa
  jubilado_a
  sin_ocupacion
  otro
}

model Persona {
  id       String @id @default(uuid())
  // Único dato de contacto con constraint de unicidad (FR-009) — el teléfono
  // explícitamente no lo es (ver Clarifications en spec.md).
  email    String @unique
  nombre   String
  apellido String

  genero             Genero
  fechaNacimiento    DateTime
  telefono           String
  direccion          String
  estadoCivil        EstadoCivil
  profesion          Profesion
  // Solo tiene sentido (y se completa) cuando profesion = otro.
  profesionDetalle   String?
  tiempoCongregacion TiempoCongregacion
  // Foto de perfil de Google (picture), guardada al registrarse. Opcional,
  // no editable por la propia Persona por ahora.
  fotoUrl            String?

  // Base Transversal (specs/002-base-transversal) — sin UI para cambiar
  // idiomaPreferido todavía (solo "es"); temaPreferido sí es editable por la
  // propia Persona vía PATCH /personas/me/preferencias.
  // H-22 (revisión manual, D106): default 'claro', no 'sistema' — ver
  // migración de datos para las Personas ya sembradas con el default viejo.
  idiomaPreferido Idioma        @default(es)
  temaPreferido   TemaPreferido @default(claro)

  sedeId String
  sede   Sede   @relation(fields: [sedeId], references: [id])

  estado                    EstadoPersona
  // Soft delete (Principio III) — independiente de `estado`. Se pone en
  // `false` cuando un pendiente_tutor no se autoriza (FR-014).
  activo                    Boolean               @default(true)
  consentimientoDatos       Boolean               @default(false)
  // Actualización 2026-09-17 (FR-013): se setean siempre juntos, solo cuando
  // consentimientoDatos=true — 'app' en POST /personas (mayor de edad),
  // 'presencial' en PATCH /personas/:id/activar (consentimiento del tutor).
  consentimientoDatosFecha  DateTime?
  consentimientoDatosOrigen OrigenConsentimiento?

  // Actualización 2026-09-17 (FR-015, D97): esta fase solo produce
  // 'autorregistro' con altaPor=null — el alta por Admin es una feature
  // propia, todavía sin flujo. altaPor es una referencia lógica al id de la
  // Persona que dio de alta, sin @relation de Prisma (ver data-model.md).
  origenAlta OrigenAlta @default(autorregistro)
  altaPor    String?

  // Solo se completan al activar un pendiente_tutor (Flujo 7, FR-008) y
  // cuando el tutor NO está vinculado como Relación Familiar (D112) — si
  // está vinculado, estos tres campos quedan en null: el vínculo es la
  // única fuente de verdad. tutorApellido (H-71, revisión manual ronda 7):
  // separado de tutorNombre igual que Persona separa nombre/apellido — un
  // solo campo de texto libre no distinguía dónde terminaba el nombre.
  tutorNombre   String?
  tutorApellido String?
  tutorTelefono String?

  // Roles acumulativos (docs/03-roles-permisos.md). Vacío hasta que la
  // Persona pasa a `activa`.
  rol String[] @default([])

  // specs/005-roles-permisos-acceso, D131/FR-002: true únicamente para la
  // Persona creada/actualizada por `scripts/recrear-admin.ts` — nunca
  // seteado desde la app en runtime. El servicio de otorgar/quitar rol
  // rechaza cualquier intento de quitarle `admin` o desactivarla mientras
  // este campo sea true, sin importar quién lo pida.
  adminSembrado Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // D112 (H-29): relaciones donde esta Persona es el sujeto (`personaId`) y
  // relaciones donde esta Persona es la vinculada (`familiarId`) — cada
  // vínculo se guarda una sola vez, nunca por los dos lados.
  relacionesComoSujeto   RelacionFamiliar[] @relation("RelacionFamiliarSujeto")
  relacionesComoFamiliar RelacionFamiliar[] @relation("RelacionFamiliarVinculado")

  // specs/005, Historia 6: el historial de cambios de rol de CARGO de esta
  // Persona (CambioDeRol, abajo). Prisma exige el lado inverso de la relación.
  cambiosDeRol CambioDeRol[]

  // specs/004-vida-nueva-discipulado (Historia 4). `disponibleDiscipulado`
  // arranca APAGADO (FR-015, Echo 2026-09-28): el Discipulador carga su agenda
  // (FranjaAgenda) y lo prende él; la agenda + el toggle son la condición para
  // aparecer en el cruce (FR-006). `maxPersonasPorGrupo`: hasta cuántas Personas
  // acepta por Grupo (FR-045), 1..MAX_PERSONAS_POR_GRUPO_VIDA_NUEVA (CHECK).
  disponibleDiscipulado Boolean @default(false)
  maxPersonasPorGrupo   Int     @default(1)

  // H-42 (revisión manual, revisión de código): PostgreSQL no indexa las
  // claves foráneas por sí solo — `sedeId` lo necesita como FK.
  // `estado` es el filtro de `findPendientesTutor` (y de cualquier consulta
  // futura que separe activas de pendiente_tutor).
  @@index([sedeId])
  @@index([estado])
  @@map("personas")
}

// H-29 (revisión manual, D63/D108, precisada por D112): vincula dos
// Personas ya registradas. En esta ronda el único tipo con un flujo real es
// `tutor` (activar un pendiente_tutor con un tutor que ya se congrega); el
// resto queda modelado para cuando una feature futura (ej. Escuelita) lo
// necesite.
enum TipoRelacionFamiliar {
  tutor
  conyuge
  hijo_a
  padre_madre
  hermano_a
}

model RelacionFamiliar {
  id String @id @default(uuid())

  // Sujeto de la relación (ej., en `tutor`, el menor). La relación inversa
  // (ej. "a_cargo") no se guarda como fila propia — no es un valor del
  // enum — se resuelve en código al consultar desde el lado de `familiar`
  // (D112). `hijo_a`/`padre_madre` sí son dos valores propios y opuestos:
  // el servicio impide crear el par espejo para el mismo vínculo.
  personaId String
  persona   Persona @relation("RelacionFamiliarSujeto", fields: [personaId], references: [id])

  familiarId String
  familiar   Persona @relation("RelacionFamiliarVinculado", fields: [familiarId], references: [id])

  tipoRelacion TipoRelacionFamiliar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Evita el duplicado literal (misma fila dos veces); el duplicado espejo
  // (mismo vínculo desde el otro lado) y la relación de una Persona consigo
  // misma se validan en el servicio, no acá (D112).
  @@unique([personaId, familiarId, tipoRelacion])
  // H-42: `personaId` ya queda indexado como prefijo izquierdo del @@unique
  // de arriba — no hace falta un índice aparte. `familiarId` (el otro lado
  // de la FK, usado por ejemplo en scripts/limpiar-e2e.ts) no está cubierto
  // por ningún índice existente.
  @@index([familiarId])
  @@map("relaciones_familiares")
}

// --- Contenido institucional (specs/003-contenido-institucional) ---
// Nombres de campo alineados con docs/04-dominio-entidades.md (Principio II).

// FR-004/FR-006/FR-012/FR-013 (data-model.md): historial completo, nunca se
// borra al reemplazarla — a diferencia de Libro, no tiene `activo` ni
// `eliminadoEn`/`eliminadoPor` (Constitution Check de plan.md, Principio III:
// nunca se elimina, ni física ni lógicamente, no hay nada que soft-deletear).
model PalabraProfetica {
  id String @id @default(uuid())

  anio  Int
  titulo String
  // D121: el texto es lo único realmente obligatorio de la palabra — sin
  // texto no hay palabra que publicar. El video es una de las formas en
  // que se comparte, no la palabra en sí.
  texto String @db.Text

  // D121 (precisa D109): el video de YouTube es OPCIONAL — puede llegar
  // después del anuncio, o no existir. Se guarda tal como la cargó el
  // Admin (para reeditar el formulario), pero el embed público siempre se
  // arma desde youtubeVideoId, nunca reparseando esta columna en cada
  // render (research.md Decisión 4). Los dos van juntos o ninguno de los
  // dos (igual que portadaUrl/portadaDescripcion en Libro) — no expresable
  // como constraint de Prisma, se valida en el service.
  youtubeUrl     String?
  youtubeVideoId String?

  // Como máximo un registro con vigente:true a la vez — invariante de
  // negocio (PalabraProfeticaService, transacción al marcar una nueva
  // vigente), no un constraint de base (mismo criterio que "Sede única
  // activa" en sede.service.ts).
  vigente Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // H-42: la subpágina pública filtra por este campo en cada visita.
  @@index([vigente])
  @@map("palabras_profeticas")
}

// FR-015 a FR-027 (data-model.md): mismo patrón D119 que Sede (activo +
// eliminadoEn/eliminadoPor), pero SIN el bloqueo por "datos relacionados" al
// eliminar (FR-020) — hoy ninguna entidad referencia a Libro. Condición del
// estado actual del modelo, no una regla permanente (ver FR-020 en spec.md).
model Libro {
  id String @id @default(uuid())

  titulo      String
  autor       String
  anio        Int
  descripcion String? @db.Text

  // Define la posición en el listado público (FR-007); editable libremente
  // por el Admin, sin unicidad forzada entre libros.
  orden Int @default(0)

  // Portada + texto alternativo: los dos juntos o ninguno de los dos
  // (validado en el service, FR-025 — no expresable como constraint de
  // Prisma). Ruta pública del archivo ya procesado por StorageService, no la
  // URL externa que subió el Admin.
  portadaUrl         String?
  portadaDescripcion String?

  activo Boolean @default(true)

  // D119: borrado lógico, independiente de `activo` — mismo criterio que
  // Sede.eliminadoEn/eliminadoPor. `eliminadoPor` es una referencia lógica
  // al id de la Persona que eliminó, sin @relation de Prisma (mismo criterio
  // que Sede.eliminadoPor/Persona.altaPor).
  eliminadoEn  DateTime?
  eliminadoPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // H-42: el listado público ordena por este campo en cada visita.
  @@index([orden])
  @@map("libros")
}

// specs/005-roles-permisos-acceso, Historia 6 (FR-022/FR-023): auditoría de
// los cambios de rol de CARGO. Solo INSERT — ninguna operación de la app hace
// UPDATE ni DELETE sobre esta tabla ("sin perderse ni sobrescribirse"), y por
// eso no tiene updatedAt ni soft delete: es el registro de un hecho pasado.
enum AccionCambioRol {
  otorgado
  quitado
}

// H-141: por qué camino se hizo el cambio. `backoffice` = un Admin desde la
// app (con autor, siempre); `recuperacion_cli` = el comando db:recrear-admin
// (FR-003), corrido por quien tenga acceso al servidor — sin autor que la
// app pueda identificar, y eso es inherente, no un dato faltante.
enum OrigenCambioRol {
  backoffice
  recuperacion_cli
}

model CambioDeRol {
  id        String          @id @default(uuid())
  personaId String
  persona   Persona         @relation(fields: [personaId], references: [id])
  rol       String
  accion    AccionCambioRol
  origen    OrigenCambioRol
  // Referencia lógica al id de la Persona Admin (mismo criterio que
  // Persona.altaPor, D97). Nullable SOLO por la fila del CLI: la invariante
  // "toda fila de backoffice tiene autor" la sostiene un CHECK en la base
  // (migración 20260925204725_cambio_de_rol), no este comentario (H-140).
  realizadoPorId String?
  createdAt      DateTime @default(now())

  // H-42: el filtro frecuente es "el historial de esta Persona".
  @@index([personaId])
  @@map("cambios_de_rol")
}

// --- Vida Nueva / Discipulado (specs/004-vida-nueva-discipulado) ---
// Nombres alineados con docs/04-dominio-entidades.md (Principio II). Las
// referencias a Persona y los "actores" (creadoPor, revisadoPor, propuestaPor,
// registradoPor, cerradoPor) son referencias lógicas —String sin @relation—,
// como Persona.altaPor y CambioDeRol.realizadoPorId: el nombre se resuelve con
// una segunda consulta. Los CHECK y los índices únicos parciales van en SQL a
// mano en la migración (patrón H-140), no se pueden expresar en el schema.

enum CategoriaCurso {
  vida_nueva
}

enum TipoCurso {
  individual
  grupal
}

enum ModalidadCurso {
  seguimiento_por_encuentros
}

enum EstadoSolicitud {
  pendiente
  propuesta
  aprobada
  rechazada
  retirada
}

enum TipoPropuesta {
  nueva
  reasignacion
}

enum EstadoPropuesta {
  pendiente
  aceptada
  declinada
  retirada
}

enum RetiradaPor {
  admin
  persona
}

enum EstadoGrupo {
  en_curso
  finalizado
}

enum MotivoCierreGrupo {
  completado
  abandonado
}

enum EstadoInscripcion {
  activa
  completada
  dada_de_baja
  abandono
}

model Curso {
  id        String         @id @default(uuid())
  nombre    String
  categoria CategoriaCurso
  tipo      TipoCurso
  modalidad ModalidadCurso
  activo    Boolean        @default(true)

  grupos    Grupo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // La API busca el Curso por (categoria, tipo), nunca por un id fijo.
  @@unique([categoria, tipo])
  @@map("cursos")
}

// FR-031: la agenda semanal del Discipulador. `inicio`/`fin` en minutos desde
// las 0:00 (0..1440), `fin > inicio` (CHECK). Borrado lógico (FR-040).
model FranjaAgenda {
  id         String    @id @default(uuid())
  personaId  String
  diaSemana  Int
  inicio     Int
  fin        Int
  eliminadaEn DateTime?
  createdAt  DateTime  @default(now())

  @@index([personaId, eliminadaEn])
  @@map("franjas_agenda")
}

// FR-032: las franjas de una Solicitud (los horarios de la Persona). Al editar
// (FR-039) se reemplazan todas. Al menos una por Solicitud lo exige el servicio.
model FranjaSolicitud {
  id          String              @id @default(uuid())
  solicitudId String
  solicitud   SolicitudDiscipulado @relation(fields: [solicitudId], references: [id])
  diaSemana   Int
  inicio      Int
  fin         Int

  @@index([solicitudId])
  @@map("franjas_solicitud")
}

model SolicitudDiscipulado {
  id            String          @id @default(uuid())
  personaId     String
  estado        EstadoSolicitud @default(pendiente)
  // null = la pidió la propia Persona; si no, el Admin/Discipulador (FR-002, D97).
  creadoPorId   String?
  revisadoPorId String?
  revisadaEn    DateTime?
  // Solo en `aprobada`. No único: varias Solicitudes pueden ir al mismo Grupo (FR-045).
  grupoId       String?

  franjas   FranjaSolicitud[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un solo pedido abierto por Persona (pendiente|propuesta): índice único
  // parcial en SQL a mano (FR-001).
  @@index([personaId])
  @@index([estado, createdAt])
  @@index([grupoId])
  @@map("solicitudes_discipulado")
}

// FR-036 a FR-038: el Admin propone, el Discipulador acepta o declina. Entidad
// propia porque FR-038 pide historial (a quién, cuándo, cómo terminó).
model PropuestaDiscipulado {
  id             String          @id @default(uuid())
  tipo           TipoPropuesta
  // `nueva` tiene solicitudId; `reasignacion` tiene grupoId (CHECK en SQL).
  solicitudId    String?
  grupoId        String?
  discipuladorId String
  // Solo en `nueva`: sumar la Persona a este Grupo en curso en vez de abrir uno (FR-045).
  grupoDestinoId String?
  propuestaPorId String
  propuestaEn    DateTime        @default(now())
  estado         EstadoPropuesta @default(pendiente)
  respondidaEn   DateTime?
  motivoDeclinacion String?
  retiradaPor    RetiradaPor?

  // Una `pendiente` por Solicitud y una por Grupo: índices únicos parciales en SQL.
  @@index([solicitudId])
  @@index([grupoId])
  @@index([discipuladorId, estado])
  @@map("propuestas_discipulado")
}

model Grupo {
  id       String @id @default(uuid())
  cursoId  String
  curso    Curso  @relation(fields: [cursoId], references: [id])
  // Referencia lógica a Sede (no navegamos Sede→Grupos en este spec).
  sedeId   String
  estado   EstadoGrupo       @default(en_curso)
  // Solo en `finalizado`: (estado = finalizado) = (motivoCierre no es null), CHECK en SQL.
  motivoCierre MotivoCierreGrupo?

  propuestaFinalizacionEn      DateTime?
  propuestaFinalizacionPorId   String?
  finalizacionRechazadaEn      DateTime?
  finalizacionRechazadaMotivo  String?
  cerradoEn                    DateTime?
  cerradoPorId                 String?

  inscripciones Inscripcion[]
  liderazgos    Liderazgo[]
  encuentros    Encuentro[]
  createdAt     DateTime @default(now())

  @@index([cursoId])
  @@index([sedeId])
  @@index([estado])
  @@map("grupos")
}

model Inscripcion {
  id          String            @id @default(uuid())
  personaId   String
  grupoId     String
  grupo       Grupo             @relation(fields: [grupoId], references: [id])
  // De qué pedido nació: sus franjas son el horario de esta Persona (research #14).
  solicitudId String            @unique
  estado      EstadoInscripcion @default(activa)

  bajaPropuestaEn     DateTime?
  bajaPropuestaPorId  String?
  bajaPropuestaMotivo String?
  bajaRechazadaEn     DateTime?
  bajaRechazadaMotivo String?
  cerradaEn           DateTime?

  asistencias Asistencia[]
  createdAt   DateTime @default(now())

  @@unique([personaId, grupoId])
  @@index([personaId])
  @@index([grupoId])
  @@map("inscripciones")
}

model Liderazgo {
  id          String    @id @default(uuid())
  personaId   String
  grupoId     String
  grupo       Grupo     @relation(fields: [grupoId], references: [id])
  desde       DateTime  @default(now())
  // null = vigente. Lo cierra una reasignación aceptada (FR-030).
  hasta       DateTime?
  // La Propuesta que lo abrió (FR-037): queda quién propuso y quién aceptó.
  propuestaId String?
  cerradoPorId String?

  // discipulados activos de una Persona (D137) y "mis discipulados".
  @@index([personaId, hasta])
  @@index([grupoId, hasta])
  @@map("liderazgos")
}

model Encuentro {
  id             String    @id @default(uuid())
  grupoId        String
  grupo          Grupo     @relation(fields: [grupoId], references: [id])
  fecha          DateTime  @db.Date
  capitulos      String
  // Solo las ve el Discipulador vigente (D134, FR-029).
  notas          String?
  registradoPorId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  asistencias Asistencia[]

  @@index([grupoId, fecha])
  @@map("encuentros")
}

model Asistencia {
  id            String      @id @default(uuid())
  encuentroId   String
  encuentro     Encuentro   @relation(fields: [encuentroId], references: [id])
  inscripcionId String
  inscripcion   Inscripcion @relation(fields: [inscripcionId], references: [id])
  // FR-013; true por defecto (FR-013a).
  presente      Boolean

  @@unique([encuentroId, inscripcionId])
  @@index([inscripcionId])
  @@map("asistencias")
}

// FR-016: período de no disponibilidad por rango de fechas civiles. `hasta >=
// desde` (CHECK). Borrado lógico (FR-040).
model BloqueoDisponibilidad {
  id         String    @id @default(uuid())
  personaId  String
  desde      DateTime  @db.Date
  hasta      DateTime  @db.Date
  eliminadoEn DateTime?
  createdAt  DateTime  @default(now())

  @@index([personaId, hasta])
  @@map("bloqueos_disponibilidad")
}
