// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  // Dentro de src/ para que tsc (rootDir: ./src en tsconfig.build.json) pueda
  // compilarlo junto con el resto del código de la app.
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Fase de Bienvenida (specs/001-fase-bienvenida) ---
// Nombres de campo alineados con docs/04-dominio-entidades.md (Constitución, Principio II).
// Ninguna entidad se borra físicamente — ambas usan `activo` (Principio III).

model Sede {
  id                    String  @id @default(uuid())
  // Único "entre Sedes activas" es una regla de negocio (SedeService), no un
  // constraint de base de datos — ver data-model.md.
  nombre                String
  direccion             String
  contactoTelefono      String?
  contactoEmail         String?
  horarios              String
  descripcionBienvenida String?
  // D218: celular argentino normalizado para wa.me (549 + 10 dígitos), opcional.
  // La API lo normaliza (`normalizarWhatsappArgentino`) y un CHECK lo asegura.
  whatsappSecretaria    String?
  activo                Boolean @default(true)

  // D119 (revisión manual ronda 6, H-67/H-69): Inactivar y Eliminar son dos
  // acciones distintas. `activo` (arriba) sigue significando el estado del
  // negocio, sin tocar — `eliminadoEn`/`eliminadoPor` son la propia marca
  // de un borrado lógico (Principio III, nunca físico) que saca el
  // registro de TODAS las vistas normales (no solo "inactivas"), con su
  // fecha y responsable. `eliminadoPor` es una referencia lógica al id de
  // la Persona que eliminó, sin @relation de Prisma (mismo criterio que
  // `Persona.altaPor`).
  eliminadoEn  DateTime?
  eliminadoPor String?

  personas Persona[]
  // spec 011: una Sede con Eventos no se puede eliminar, solo inactivar (D119).
  eventos  Evento[]
  // spec 014: los Grupos de Extensión que se reúnen "En la iglesia".
  gruposExtension GrupoExtension[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("sedes")
}

enum Genero {
  masculino
  femenino
}

enum EstadoCivil {
  soltero_a
  casado_a
  en_concubinato
  viudo_a
  divorciado_a
  separado_a
}

enum EstadoPersona {
  activa
  pendiente_tutor
}

// --- Base Transversal (specs/002-base-transversal) ---

enum Idioma {
  es
}

enum TemaPreferido {
  claro
  oscuro
  sistema
}

// --- Fase de Bienvenida, actualización 2026-09-17 (D97, FR-013, FR-015) ---

enum OrigenConsentimiento {
  app
  presencial
}

enum OrigenAlta {
  autorregistro
  admin
}

enum Profesion {
  salud
  educacion
  tecnologia_ingenieria
  comercio_ventas
  oficios_construccion
  administracion_finanzas
  legal
  comunicacion_marketing
  arte_diseno
  servicios_gastronomia
  transporte
  estudiante
  ama_de_casa
  jubilado_a
  sin_ocupacion
  otro
}

model Persona {
  id       String @id @default(uuid())
  // Único dato de contacto con constraint de unicidad (FR-009) — el teléfono
  // explícitamente no lo es (ver Clarifications en spec.md).
  // D145 (spec 006): opcional — una Persona dada de alta por el Admin puede no
  // tener email (sin acceso a la app). Sigue único entre quienes lo tienen
  // (Postgres admite varios NULL en un índice único). Se guarda normalizado
  // (trim + minúsculas, `normalizarEmail`, spec 007): la migración del lote 0
  // normalizó los existentes y falla si dos chocan.
  email    String? @unique
  // D215: opcional, solo lo carga el Admin (alta y edición en el backoffice,
  // nunca el registro propio). Solo dígitos (7 u 8, `normalizarDni`). Único
  // entre todas las Personas, activas o no, con un índice único parcial
  // `WHERE dni IS NOT NULL` en SQL (migración `dni_persona`). Dato sensible:
  // no va a listados, a logs ni a quien no tenga `personas.ver`.
  dni      String?
  nombre   String
  apellido String

  genero             Genero
  fechaNacimiento    DateTime
  telefono           String
  // D145 (spec 006, research #7): solo dígitos y sin el 9 de celular de AR
  // (`normalizarTelefono`, shared-types). Lo calcula la BASE con un trigger
  // en cada INSERT/UPDATE de `telefono` (migración lote_0_global): ningún
  // camino de escritura puede olvidarlo. El código nunca lo escribe; el
  // `@default("")` es solo para que Prisma no lo exija al crear.
  telefonoNormalizado String @default("")
  direccion          String
  estadoCivil        EstadoCivil
  profesion          Profesion
  // Solo tiene sentido (y se completa) cuando profesion = otro.
  profesionDetalle   String?
  // D214: el año en que la Persona empezó a venir a la iglesia. El tiempo
  // congregándose se calcula al mostrarlo (`rangoCongregacion`, shared-types),
  // así queda al día. Reemplaza al viejo rango `tiempoCongregacion`: la
  // migración del lote 0 lo convirtió (año de registro − límite inferior).
  congregaDesde      Int
  // Foto de perfil de Google (picture), guardada al registrarse. Opcional,
  // no editable por la propia Persona por ahora.
  fotoUrl            String?

  // Base Transversal (specs/002-base-transversal) — sin UI para cambiar
  // idiomaPreferido todavía (solo "es"); temaPreferido sí es editable por la
  // propia Persona vía PATCH /personas/me/preferencias.
  // H-22 (revisión manual, D106): default 'claro', no 'sistema' — ver
  // migración de datos para las Personas ya sembradas con el default viejo.
  idiomaPreferido Idioma        @default(es)
  temaPreferido   TemaPreferido @default(claro)

  sedeId String
  sede   Sede   @relation(fields: [sedeId], references: [id])

  estado                    EstadoPersona
  // Soft delete (Principio III) — independiente de `estado`. Se pone en
  // `false` cuando un pendiente_tutor no se autoriza (FR-014).
  activo                    Boolean               @default(true)
  consentimientoDatos       Boolean               @default(false)
  // Actualización 2026-09-17 (FR-013): se setean siempre juntos, solo cuando
  // consentimientoDatos=true — 'app' en POST /personas (mayor de edad),
  // 'presencial' en PATCH /personas/:id/activar (consentimiento del tutor).
  consentimientoDatosFecha  DateTime?
  consentimientoDatosOrigen OrigenConsentimiento?

  // Actualización 2026-09-17 (FR-015, D97): esta fase solo produce
  // 'autorregistro' con altaPor=null — el alta por Admin es una feature
  // propia, todavía sin flujo. altaPor es una referencia lógica al id de la
  // Persona que dio de alta, sin @relation de Prisma (ver data-model.md).
  origenAlta OrigenAlta @default(autorregistro)
  altaPor    String?

  // Solo se completan al activar un pendiente_tutor (Flujo 7, FR-008) y
  // cuando el tutor NO está vinculado como Relación Familiar (D112) — si
  // está vinculado, estos tres campos quedan en null: el vínculo es la
  // única fuente de verdad. tutorApellido (H-71, revisión manual ronda 7):
  // separado de tutorNombre igual que Persona separa nombre/apellido — un
  // solo campo de texto libre no distinguía dónde terminaba el nombre.
  tutorNombre   String?
  tutorApellido String?
  tutorTelefono String?

  // Roles acumulativos (docs/03-roles-permisos.md). Vacío hasta que la
  // Persona pasa a `activa`.
  rol String[] @default([])

  // specs/005-roles-permisos-acceso, D131/FR-002: true únicamente para la
  // Persona creada/actualizada por `scripts/recrear-admin.ts` — nunca
  // seteado desde la app en runtime. El servicio de otorgar/quitar rol
  // rechaza cualquier intento de quitarle `admin` o desactivarla mientras
  // este campo sea true, sin importar quién lo pida.
  adminSembrado Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // D112 (H-29): relaciones donde esta Persona es el sujeto (`personaId`) y
  // relaciones donde esta Persona es la vinculada (`familiarId`) — cada
  // vínculo se guarda una sola vez, nunca por los dos lados.
  relacionesComoSujeto   RelacionFamiliar[] @relation("RelacionFamiliarSujeto")
  relacionesComoFamiliar RelacionFamiliar[] @relation("RelacionFamiliarVinculado")

  // specs/005, Historia 6: el historial de cambios de rol de CARGO de esta
  // Persona (CambioDeRol, abajo). Prisma exige el lado inverso de la relación.
  cambiosDeRol CambioDeRol[]

  // specs/004-vida-nueva-discipulado (Historia 4). `disponibleDiscipulado`
  // arranca APAGADO (FR-015, Echo 2026-09-28): el Discipulador carga su agenda
  // (FranjaAgenda) y lo prende él; la agenda + el toggle son la condición para
  // aparecer en el cruce (FR-006). `maxPersonasPorGrupo`: hasta cuántas Personas
  // acepta por Grupo (FR-045), 1..MAX_PERSONAS_POR_GRUPO_VIDA_NUEVA (CHECK).
  disponibleDiscipulado Boolean @default(false)
  maxPersonasPorGrupo   Int     @default(1)

  // specs/010-bautismo (D147, FR-021): el Admin habilita a pedir el bautismo
  // sin Vida Nueva. Los dos juntos o ninguno (CHECK en SQL).
  bautismoHabilitadoEn    DateTime?
  bautismoHabilitadoPorId String?

  // Relaciones de las specs 010–013 (lote 0 global).
  solicitudesBautismo   SolicitudBautismo[]
  inscripcionesEvento   InscripcionEvento[]
  entregasNotificacion  EntregaNotificacion[]
  notificacionesCreadas Notificacion[]       @relation("NotificacionesCreadas")
  comentarios           ComentarioApp[]      @relation("ComentariosDePersona")
  comentariosRevisados  ComentarioApp[]      @relation("ComentariosRevisados")

  // spec 014: Grupos de Extensión.
  liderazgosExtension   LiderGrupoExtension[]
  solicitudesExtension  SolicitudGrupoExtension[]

  // H-42 (revisión manual, revisión de código): PostgreSQL no indexa las
  // claves foráneas por sí solo — `sedeId` lo necesita como FK.
  // `estado` es el filtro de `findPendientesTutor` (y de cualquier consulta
  // futura que separe activas de pendiente_tutor).
  @@index([sedeId])
  @@index([estado])
  // D145: aviso de posible duplicado (igualdad de teléfono normalizado y
  // candidatos por fecha de nacimiento). Además, en SQL a mano, un índice de
  // expresión sobre el mes de `fechaNacimiento` para los cumpleaños (spec 013).
  @@index([telefonoNormalizado])
  @@index([fechaNacimiento])
  @@map("personas")
}

// H-29 (revisión manual, D63/D108, precisada por D112): vincula dos
// Personas ya registradas. En esta ronda el único tipo con un flujo real es
// `tutor` (activar un pendiente_tutor con un tutor que ya se congrega); el
// resto queda modelado para cuando una feature futura (ej. Escuelita) lo
// necesite.
enum TipoRelacionFamiliar {
  tutor
  conyuge
  hijo_a
  padre_madre
  hermano_a
}

model RelacionFamiliar {
  id String @id @default(uuid())

  // Sujeto de la relación (ej., en `tutor`, el menor). La relación inversa
  // (ej. "a_cargo") no se guarda como fila propia — no es un valor del
  // enum — se resuelve en código al consultar desde el lado de `familiar`
  // (D112). `hijo_a`/`padre_madre` sí son dos valores propios y opuestos:
  // el servicio impide crear el par espejo para el mismo vínculo.
  personaId String
  persona   Persona @relation("RelacionFamiliarSujeto", fields: [personaId], references: [id])

  familiarId String
  familiar   Persona @relation("RelacionFamiliarVinculado", fields: [familiarId], references: [id])

  tipoRelacion TipoRelacionFamiliar

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Evita el duplicado literal (misma fila dos veces); el duplicado espejo
  // (mismo vínculo desde el otro lado) y la relación de una Persona consigo
  // misma se validan en el servicio, no acá (D112).
  @@unique([personaId, familiarId, tipoRelacion])
  // H-42: `personaId` ya queda indexado como prefijo izquierdo del @@unique
  // de arriba — no hace falta un índice aparte. `familiarId` (el otro lado
  // de la FK, usado por ejemplo en scripts/limpiar-e2e.ts) no está cubierto
  // por ningún índice existente.
  @@index([familiarId])
  @@map("relaciones_familiares")
}

// --- Contenido institucional (specs/003-contenido-institucional) ---
// Nombres de campo alineados con docs/04-dominio-entidades.md (Principio II).

// FR-004/FR-006/FR-012/FR-013 (data-model.md): historial completo, nunca se
// borra al reemplazarla — a diferencia de Libro, no tiene `activo` ni
// `eliminadoEn`/`eliminadoPor` (Constitution Check de plan.md, Principio III:
// nunca se elimina, ni física ni lógicamente, no hay nada que soft-deletear).
model PalabraProfetica {
  id String @id @default(uuid())

  anio  Int
  titulo String
  // D121: el texto es lo único realmente obligatorio de la palabra — sin
  // texto no hay palabra que publicar. El video es una de las formas en
  // que se comparte, no la palabra en sí.
  texto String @db.Text

  // D121 (precisa D109): el video de YouTube es OPCIONAL — puede llegar
  // después del anuncio, o no existir. Se guarda tal como la cargó el
  // Admin (para reeditar el formulario), pero el embed público siempre se
  // arma desde youtubeVideoId, nunca reparseando esta columna en cada
  // render (research.md Decisión 4). Los dos van juntos o ninguno de los
  // dos (igual que portadaUrl/portadaDescripcion en Libro) — no expresable
  // como constraint de Prisma, se valida en el service.
  youtubeUrl     String?
  youtubeVideoId String?

  // Como máximo un registro con vigente:true a la vez — invariante de
  // negocio (PalabraProfeticaService, transacción al marcar una nueva
  // vigente), no un constraint de base (mismo criterio que "Sede única
  // activa" en sede.service.ts).
  vigente Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // H-42: la subpágina pública filtra por este campo en cada visita.
  @@index([vigente])
  @@map("palabras_profeticas")
}

// FR-015 a FR-027 (data-model.md): mismo patrón D119 que Sede (activo +
// eliminadoEn/eliminadoPor), pero SIN el bloqueo por "datos relacionados" al
// eliminar (FR-020) — hoy ninguna entidad referencia a Libro. Condición del
// estado actual del modelo, no una regla permanente (ver FR-020 en spec.md).
model Libro {
  id String @id @default(uuid())

  titulo      String
  autor       String
  anio        Int
  descripcion String? @db.Text

  // Define la posición en el listado público (FR-007); editable libremente
  // por el Admin, sin unicidad forzada entre libros.
  orden Int @default(0)

  // Portada + texto alternativo: los dos juntos o ninguno de los dos
  // (validado en el service, FR-025 — no expresable como constraint de
  // Prisma). Ruta pública del archivo ya procesado por StorageService, no la
  // URL externa que subió el Admin.
  portadaUrl         String?
  portadaDescripcion String?

  activo Boolean @default(true)

  // D119: borrado lógico, independiente de `activo` — mismo criterio que
  // Sede.eliminadoEn/eliminadoPor. `eliminadoPor` es una referencia lógica
  // al id de la Persona que eliminó, sin @relation de Prisma (mismo criterio
  // que Sede.eliminadoPor/Persona.altaPor).
  eliminadoEn  DateTime?
  eliminadoPor String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // H-42: el listado público ordena por este campo en cada visita.
  @@index([orden])
  @@map("libros")
}

// specs/005-roles-permisos-acceso, Historia 6 (FR-022/FR-023): auditoría de
// los cambios de rol de CARGO. Solo INSERT — ninguna operación de la app hace
// UPDATE ni DELETE sobre esta tabla ("sin perderse ni sobrescribirse"), y por
// eso no tiene updatedAt ni soft delete: es el registro de un hecho pasado.
enum AccionCambioRol {
  otorgado
  quitado
}

// H-141: por qué camino se hizo el cambio. `backoffice` = un Admin desde la
// app (con autor, siempre); `recuperacion_cli` = el comando db:recrear-admin
// (FR-003), corrido por quien tenga acceso al servidor — sin autor que la
// app pueda identificar, y eso es inherente, no un dato faltante.
enum OrigenCambioRol {
  backoffice
  recuperacion_cli
}

model CambioDeRol {
  id        String          @id @default(uuid())
  personaId String
  persona   Persona         @relation(fields: [personaId], references: [id])
  rol       String
  accion    AccionCambioRol
  origen    OrigenCambioRol
  // Referencia lógica al id de la Persona Admin (mismo criterio que
  // Persona.altaPor, D97). Nullable SOLO por la fila del CLI: la invariante
  // "toda fila de backoffice tiene autor" la sostiene un CHECK en la base
  // (migración 20260925204725_cambio_de_rol), no este comentario (H-140).
  realizadoPorId String?
  createdAt      DateTime @default(now())

  // H-42: el filtro frecuente es "el historial de esta Persona".
  @@index([personaId])
  @@map("cambios_de_rol")
}

// --- Vida Nueva / Discipulado (specs/004-vida-nueva-discipulado) ---
// Nombres alineados con docs/04-dominio-entidades.md (Principio II). Las
// referencias a Persona y los "actores" (creadoPor, revisadoPor, propuestaPor,
// registradoPor, cerradoPor) son referencias lógicas —String sin @relation—,
// como Persona.altaPor y CambioDeRol.realizadoPorId: el nombre se resuelve con
// una segunda consulta. Los CHECK y los índices únicos parciales van en SQL a
// mano en la migración (patrón H-140), no se pueden expresar en el schema.

enum CategoriaCurso {
  vida_nueva
  // spec 008
  vida_de_servicio
}

enum TipoCurso {
  individual
  grupal
}

enum ModalidadCurso {
  seguimiento_por_encuentros
  // spec 008
  liberacion_programada
}

// spec 008 (D158): el tipo propuesto o aplicado de una baja de Vida de Servicio.
enum TipoBaja {
  dada_de_baja
  abandono
}

enum EstadoSolicitud {
  pendiente
  propuesta
  aprobada
  rechazada
  retirada
}

enum TipoPropuesta {
  nueva
  reasignacion
}

enum EstadoPropuesta {
  pendiente
  aceptada
  declinada
  retirada
}

enum RetiradaPor {
  admin
  persona
}

enum EstadoGrupo {
  en_curso
  finalizado
}

enum MotivoCierreGrupo {
  completado
  abandonado
}

enum EstadoInscripcion {
  activa
  completada
  dada_de_baja
  abandono
}

model Curso {
  id        String         @id @default(uuid())
  nombre    String
  categoria CategoriaCurso
  tipo      TipoCurso
  modalidad ModalidadCurso
  activo    Boolean        @default(true)
  // spec 008: para inscribirse hay que haber completado una etapa de esta
  // categoría (`vida_nueva` para Vida de Servicio). null = sin prerrequisito.
  prerequisitoCategoria CategoriaCurso?
  // spec 013 (D212, D119): el Admin edita nombre y descripción; borrado lógico.
  descripcion  String?
  eliminadoEn  DateTime?
  eliminadoPor String?

  grupos    Grupo[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // La API busca el Curso por (categoria, tipo), nunca por un id fijo.
  @@unique([categoria, tipo])
  @@map("cursos")
}

// FR-031: la agenda semanal del Discipulador. `inicio`/`fin` en minutos desde
// las 0:00 (0..1440), `fin > inicio` (CHECK). Borrado lógico (FR-040).
model FranjaAgenda {
  id         String    @id @default(uuid())
  personaId  String
  diaSemana  Int
  inicio     Int
  fin        Int
  eliminadaEn DateTime?
  createdAt  DateTime  @default(now())

  @@index([personaId, eliminadaEn])
  @@map("franjas_agenda")
}

// FR-032: las franjas de una Solicitud (los horarios de la Persona). Al editar
// (FR-039) se reemplazan todas. Al menos una por Solicitud lo exige el servicio.
model FranjaSolicitud {
  id          String              @id @default(uuid())
  solicitudId String
  solicitud   SolicitudDiscipulado @relation(fields: [solicitudId], references: [id])
  diaSemana   Int
  inicio      Int
  fin         Int

  @@index([solicitudId])
  @@map("franjas_solicitud")
}

model SolicitudDiscipulado {
  id            String          @id @default(uuid())
  personaId     String
  estado        EstadoSolicitud @default(pendiente)
  // null = la pidió la propia Persona; si no, el Admin/Discipulador (FR-002, D97).
  creadoPorId   String?
  revisadoPorId String?
  revisadaEn    DateTime?
  // Solo en `aprobada`. No único: varias Solicitudes pueden ir al mismo Grupo (FR-045).
  grupoId       String?

  franjas   FranjaSolicitud[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Un solo pedido abierto por Persona (pendiente|propuesta): índice único
  // parcial en SQL a mano (FR-001).
  @@index([personaId])
  @@index([estado, createdAt])
  @@index([grupoId])
  @@map("solicitudes_discipulado")
}

// FR-036 a FR-038: el Admin propone, el Discipulador acepta o declina. Entidad
// propia porque FR-038 pide historial (a quién, cuándo, cómo terminó).
model PropuestaDiscipulado {
  id             String          @id @default(uuid())
  tipo           TipoPropuesta
  // `nueva` tiene solicitudId; `reasignacion` tiene grupoId (CHECK en SQL).
  solicitudId    String?
  grupoId        String?
  discipuladorId String
  // Solo en `nueva`: sumar la Persona a este Grupo en curso en vez de abrir uno (FR-045).
  grupoDestinoId String?
  propuestaPorId String
  propuestaEn    DateTime        @default(now())
  estado         EstadoPropuesta @default(pendiente)
  respondidaEn   DateTime?
  motivoDeclinacion String?
  retiradaPor    RetiradaPor?

  // Una `pendiente` por Solicitud y una por Grupo: índices únicos parciales en SQL.
  @@index([solicitudId])
  @@index([grupoId])
  @@index([discipuladorId, estado])
  @@map("propuestas_discipulado")
}

model Grupo {
  id       String @id @default(uuid())
  cursoId  String
  curso    Curso  @relation(fields: [cursoId], references: [id])
  // Referencia lógica a Sede (no navegamos Sede→Grupos en este spec).
  sedeId   String
  estado   EstadoGrupo       @default(en_curso)
  // Solo en `finalizado`: (estado = finalizado) = (motivoCierre no es null), CHECK en SQL.
  motivoCierre MotivoCierreGrupo?

  propuestaFinalizacionEn      DateTime?
  propuestaFinalizacionPorId   String?
  finalizacionRechazadaEn      DateTime?
  finalizacionRechazadaMotivo  String?
  cerradoEn                    DateTime?
  cerradoPorId                 String?

  // spec 008: una edición de Vida de Servicio tiene nombre (≤ 80) y fecha de
  // inicio (obligatorios ahí, lo valida el servicio); Vida Nueva los deja null.
  nombre             String?
  fechaInicio        DateTime? @db.Date
  inscripcionAbierta Boolean   @default(false)

  inscripciones Inscripcion[]
  liderazgos    Liderazgo[]
  encuentros    Encuentro[]
  items         ItemCronograma[]
  contenidos    Contenido[]
  solicitudesVidaServicio SolicitudVidaServicio[]
  createdAt     DateTime @default(now())

  @@index([cursoId])
  @@index([sedeId])
  @@index([estado])
  @@map("grupos")
}

model Inscripcion {
  id          String            @id @default(uuid())
  personaId   String
  grupoId     String
  grupo       Grupo             @relation(fields: [grupoId], references: [id])
  // De qué pedido nació: sus franjas son el horario de esta Persona (research
  // #14). spec 008: una Inscripción nace de una Solicitud de Discipulado O de
  // una Solicitud de Vida de Servicio — exactamente una (CHECK num_nonnulls).
  solicitudId             String?           @unique
  solicitudVidaServicioId String?           @unique
  solicitudVidaServicio   SolicitudVidaServicio? @relation(fields: [solicitudVidaServicioId], references: [id])
  estado      EstadoInscripcion @default(activa)
  // spec 008 (D158): tipo propuesto por el Líder; solo Vida de Servicio.
  bajaPropuestaTipo TipoBaja?

  bajaPropuestaEn     DateTime?
  bajaPropuestaPorId  String?
  bajaPropuestaMotivo String?
  bajaRechazadaEn     DateTime?
  bajaRechazadaMotivo String?
  cerradaEn           DateTime?

  asistencias Asistencia[]
  createdAt   DateTime @default(now())

  @@unique([personaId, grupoId])
  @@index([personaId])
  @@index([grupoId])
  @@map("inscripciones")
}

model Liderazgo {
  id          String    @id @default(uuid())
  personaId   String
  grupoId     String
  grupo       Grupo     @relation(fields: [grupoId], references: [id])
  desde       DateTime  @default(now())
  // null = vigente. Lo cierra una reasignación aceptada (FR-030).
  hasta       DateTime?
  // La Propuesta que lo abrió (FR-037): queda quién propuso y quién aceptó.
  propuestaId String?
  cerradoPorId String?

  // discipulados activos de una Persona (D137) y "mis discipulados".
  @@index([personaId, hasta])
  @@index([grupoId, hasta])
  @@map("liderazgos")
}

model Encuentro {
  id             String    @id @default(uuid())
  grupoId        String
  grupo          Grupo     @relation(fields: [grupoId], references: [id])
  fecha          DateTime  @db.Date
  // spec 008: opcional — un Encuentro de asistencia de Vida de Servicio no
  // tiene capítulos (uno por Grupo y fecha, índice parcial en SQL). Vida Nueva
  // lo sigue exigiendo en su servicio.
  capitulos      String?
  // Solo las ve el Discipulador vigente (D134, FR-029).
  notas          String?
  registradoPorId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  asistencias Asistencia[]

  @@index([grupoId, fecha])
  @@map("encuentros")
}

model Asistencia {
  id            String      @id @default(uuid())
  encuentroId   String
  encuentro     Encuentro   @relation(fields: [encuentroId], references: [id])
  inscripcionId String
  inscripcion   Inscripcion @relation(fields: [inscripcionId], references: [id])
  // FR-013; true por defecto (FR-013a).
  presente      Boolean

  @@unique([encuentroId, inscripcionId])
  @@index([inscripcionId])
  @@map("asistencias")
}

// FR-016: período de no disponibilidad por rango de fechas civiles. `hasta >=
// desde` (CHECK). Borrado lógico (FR-040).
model BloqueoDisponibilidad {
  id         String    @id @default(uuid())
  personaId  String
  desde      DateTime  @db.Date
  hasta      DateTime  @db.Date
  eliminadoEn DateTime?
  createdAt  DateTime  @default(now())

  @@index([personaId, hasta])
  @@map("bloqueos_disponibilidad")
}

// ============================================================================
// Lote 0 global (specs 006–013): todos los modelos nuevos en un solo lugar.
// Los CHECK, índices únicos parciales, la vista de la bandeja y los índices de
// expresión van en SQL a mano en la migración `lote_0_global` (patrón H-140).
// Las referencias a "actores" (*PorId) son referencias lógicas a Persona sin
// @relation, como en la 004, salvo donde la data-model de la spec pide una
// relación (ver specs/IMPLEMENTACION.md → Convenciones del schema).
// ============================================================================

// --- spec 006: Mi camino por etapas, historial previo (D153, D154) ---

enum EtapaCamino {
  vida_nueva
  vida_de_servicio
  ministerio
  bautismo
}

enum EstadoDeclaracion {
  pendiente
  confirmada
  rechazada
  retirada
}

enum OrigenCompletitud {
  declaracion // la confirmó el Admin a partir de un "Ya lo hice"
  admin       // la registró el Admin directamente (Flujo 9)
}

// Lo que la Persona declara con "Ya lo hice" (forma común de las Solicitudes).
// Una sola `pendiente` por Persona y etapa (índice parcial en SQL).
model DeclaracionHistorial {
  id            String            @id @default(uuid())
  personaId     String
  etapa         EtapaCamino
  estado        EstadoDeclaracion @default(pendiente)
  // Opcional, ≤ 500 (CHECK). Lo escribe la Persona; lo lee el Admin.
  comentario    String?
  // null = la propia Persona (forma común; hoy siempre null).
  creadoPorId   String?
  revisadoPorId String?
  revisadaEn    DateTime?
  // Solo en `rechazada`, opcional, ≤ 500. Lo ve la Persona.
  motivoRechazo String?
  retiradaEn    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  completitud CompletitudManual?

  @@index([personaId, etapa])
  @@index([estado, createdAt])
  @@map("declaraciones_historial")
}

// Lo que el sistema CUENTA como etapa hecha fuera del flujo normal (D153).
// Una vigente por Persona y etapa (índice parcial en SQL). La consulta única
// "¿completó esta etapa?" es `completoEtapa` (apps/api/src/camino/consultas.ts).
model CompletitudManual {
  id              String                @id @default(uuid())
  personaId       String
  etapa           EtapaCamino
  origen          OrigenCompletitud
  // Solo si origen = declaracion (CHECK).
  declaracionId   String?               @unique
  declaracion     DeclaracionHistorial? @relation(fields: [declaracionId], references: [id])
  nota            String?
  registradaPorId String
  registradaEn    DateTime              @default(now())
  // Borrado lógico (Principio III).
  anuladaEn       DateTime?
  anuladaPorId    String?

  @@index([personaId, etapa])
  @@map("completitudes_manuales")
}

// --- spec 007: Ingreso con código por email (D141) ---

// Secreto efímero: se borra a las 24 h o si falla el envío (excepción
// justificada al Principio III, plan de la 007). No se vincula a una Persona.
model CodigoIngreso {
  id               String    @id @default(uuid())
  // Normalizado (`normalizarEmail`).
  email            String
  // HMAC-SHA256 con CODIGO_INGRESO_SECRET; nunca el código en claro.
  codigoHuella     String
  // HMAC-SHA256 de la IP; nunca la IP en claro.
  origenHuella     String
  venceEn          DateTime
  intentosFallidos Int       @default(0)
  usadoEn          DateTime?
  reemplazadoEn    DateTime?
  creadoEn         DateTime  @default(now())

  @@index([email, creadoEn])
  @@index([origenHuella, creadoEn])
  @@map("codigos_ingreso")
}

// --- spec 008: Vida de Servicio ---

// El Cronograma son los items del Grupo (D161). Únicos parciales y CHECK en SQL.
model ItemCronograma {
  id              String    @id @default(uuid())
  grupoId         String
  grupo           Grupo     @relation(fields: [grupoId], references: [id])
  numeroSemana    Int
  fechaLiberacion DateTime  @db.Date
  eliminadoEn     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  contenido Contenido?

  @@index([grupoId, fechaLiberacion])
  @@map("items_cronograma")
}

// Un Contenido por semana, con varias piezas (D161). Se ve el día de su fecha
// si está cargado — calculado al leer (D162).
model Contenido {
  id                  String         @id @default(uuid())
  grupoId             String
  grupo               Grupo          @relation(fields: [grupoId], references: [id])
  itemCronogramaId    String         @unique
  itemCronograma      ItemCronograma @relation(fields: [itemCronogramaId], references: [id])
  titulo              String
  texto               String?
  cargadoPorId        String
  cargadoEn           DateTime       @default(now())
  editadoPorId        String?
  editadoEn           DateTime?
  // El aviso `vida_servicio.contenido_liberado` sale una sola vez.
  liberacionAvisadaEn DateTime?

  archivos ArchivoContenido[]
  enlaces  EnlaceContenido[]

  @@index([grupoId])
  @@map("contenidos")
}

// Archivo privado (D168): área `contenidos` de StorageService, servido solo
// por la API con permiso por pedido.
model ArchivoContenido {
  id               String    @id @default(uuid())
  contenidoId      String
  contenido        Contenido @relation(fields: [contenidoId], references: [id])
  ruta             String
  nombreOriginal   String
  mimeType         String
  tamanioBytes     Int
  textoAlternativo String?
  orden            Int
  eliminadoEn      DateTime?
  eliminadoPorId   String?
  createdAt        DateTime  @default(now())

  @@index([contenidoId, eliminadoEn])
  @@map("archivos_contenido")
}

model EnlaceContenido {
  id          String    @id @default(uuid())
  contenidoId String
  contenido   Contenido @relation(fields: [contenidoId], references: [id])
  texto       String
  url         String
  orden       Int
  eliminadoEn DateTime?
  createdAt   DateTime  @default(now())

  @@index([contenidoId, eliminadoEn])
  @@map("enlaces_contenido")
}

// Forma común de las Solicitudes. Reusa EstadoSolicitud sin `propuesta`
// (CHECK). Una sola pendiente por Persona (índice parcial).
model SolicitudVidaServicio {
  id            String          @id @default(uuid())
  personaId     String
  estado        EstadoSolicitud @default(pendiente)
  // Edición pedida; null = "para la próxima edición" (D163).
  grupoId       String?
  grupo         Grupo?          @relation(fields: [grupoId], references: [id])
  creadoPorId   String?
  revisadoPorId String?
  revisadaEn    DateTime?
  motivoRechazo String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  inscripcion Inscripcion?

  @@index([personaId])
  @@index([estado, createdAt])
  @@index([grupoId])
  @@map("solicitudes_vida_servicio")
}

// --- spec 009: Ministerios y Células ---

enum EstadoPostulacion {
  pendiente
  aprobada
  rechazada
  inactiva
  retirada
}

enum MotivoInactivacionPostulacion {
  cambio_de_ministerio
  baja
}

model Ministerio {
  id           String    @id @default(uuid())
  nombre       String
  descripcion  String
  // docs/22 (migración `ministerios_contenido`): la "línea pública" (lo único
  // que muestra la web pública además del nombre) y si requiere capacitación
  // o audición antes de servir.
  lineaPublica      String?
  requiereFormacion Boolean   @default(false)
  activo       Boolean   @default(true)
  eliminadoEn  DateTime?
  eliminadoPor String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  celulas       Celula[]
  postulaciones Postulacion[]

  @@index([activo, eliminadoEn])
  @@map("ministerios")
}

model Celula {
  id           String     @id @default(uuid())
  ministerioId String
  ministerio   Ministerio @relation(fields: [ministerioId], references: [id])
  nombre       String
  // docs/22: qué se hace en esta área (lo ve la Persona al postularse).
  descripcion  String?
  // docs/22: "Discipulados Vida Nueva" — al aprobar, el Admin puede otorgar
  // el rol `discipulador` en el mismo paso (reglas de la 005).
  ofreceRolDiscipulador Boolean @default(false)
  activo       Boolean    @default(true)
  eliminadoEn  DateTime?
  eliminadoPor String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  postulaciones Postulacion[]

  @@index([ministerioId])
  @@map("celulas")
}

// La membresía ES la Postulación `aprobada` (D170). Una pendiente y una
// aprobada por Persona como máximo (índices parciales en SQL); las de un área
// que se sirve en paralelo (`enParalelo`, D217) llevan su propia aprobada.
model Postulacion {
  id                 String                         @id @default(uuid())
  personaId          String
  ministerioId       String
  ministerio         Ministerio                     @relation(fields: [ministerioId], references: [id])
  celulaId           String?
  celula             Celula?                        @relation(fields: [celulaId], references: [id])
  estado             EstadoPostulacion              @default(pendiente)
  motivacion         String?
  disponibilidad     String?
  creadoPorId        String?
  revisadoPorId      String?
  revisadaEn         DateTime?
  motivoRechazo      String?
  retiradaEn         DateTime?
  motivoInactivacion MotivoInactivacionPostulacion?
  inactivadaEn       DateTime?
  inactivadaPorId    String?
  reemplazadaPorId   String?
  motivoBaja         String?
  // docs/22: copia de `Ministerio.requiereFormacion` al postularse — el Admin
  // ve la marca aunque después cambie el catálogo.
  requiereFormacion  Boolean                        @default(false)
  // D217: copia de `Celula.ofreceRolDiscipulador` al postularse — "Discipulados
  // Vida Nueva" se sirve en paralelo con cualquier Ministerio (docs/22): su
  // aprobada no reemplaza la membresía ni cuenta para `postulaciones_una_aprobada`.
  enParalelo         Boolean                        @default(false)
  createdAt          DateTime                       @default(now())
  updatedAt          DateTime                       @updatedAt

  @@index([personaId])
  @@index([estado, createdAt])
  @@index([ministerioId, estado])
  @@index([celulaId])
  @@map("postulaciones")
}

// --- spec 010: Bautismo ---

enum EstadoSolicitudBautismo {
  pendiente
  aprobada  // "aceptada" en la interfaz; sin o con Evento asignado
  rechazada
  retirada
  realizada // el Admin confirmó que se bautizó (D180)
}

// D229: en el orden de `TALLES_REMERA` (shared-types).
enum TalleRemera {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

model SolicitudBautismo {
  id                  String                  @id @default(uuid())
  personaId           String
  persona             Persona                 @relation(fields: [personaId], references: [id])
  estado              EstadoSolicitudBautismo @default(pendiente)
  // ≤ 500. Reemplaza la fecha deseada (D179).
  comentario          String?
  // D229: el talle de la remera que regala la iglesia. Obligatorio al pedir;
  // null solo en los pedidos de antes del ajuste ("Sin dato").
  talleRemera         TalleRemera?
  // null = la pidió la propia Persona (D97).
  creadoPorId         String?
  revisadoPorId       String?
  revisadaEn          DateTime?
  // Solo para el equipo (D185); nunca sale en /bautismo/me.
  motivoRechazo       String?
  // La asignación vigente a un Evento de bautismo (D181).
  inscripcionEventoId String?                 @unique
  inscripcionEvento   InscripcionEvento?      @relation(fields: [inscripcionEventoId], references: [id])
  realizadaEn         DateTime?
  retiradaEn          DateTime?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([personaId])
  @@index([estado, createdAt])
  @@map("solicitudes_bautismo")
}

// --- spec 011: Eventos ---

enum TipoEvento {
  general
  bautismo
}

enum EstadoEvento {
  publicado
  cancelado
}

enum EstadoInscripcionEvento {
  confirmada
  pendiente
  rechazada
  lista_espera
  cancelada
}

enum MotivoCancelacionInscripcion {
  persona
  admin
  pago_rechazado
}

enum MedioPago {
  transferencia
  efectivo
  otro
}

enum EstadoPago {
  pendiente_verificacion
  verificado
  rechazado
}

model Evento {
  id                           String       @id @default(uuid())
  sedeId                       String
  sede                         Sede         @relation(fields: [sedeId], references: [id])
  nombre                       String
  // Se genera al crear y nunca cambia (D194).
  slug                         String       @unique
  descripcion                  String
  tipo                         TipoEvento   @default(general)
  inicio                       DateTime     @db.Timestamptz
  fin                          DateTime?    @db.Timestamptz
  // null = la dirección de la Sede (D190).
  lugar                        String?
  publicoObjetivo              String?
  imagenUrl                    String?
  imagenRuta                   String?
  descripcionImagen            String?
  requiereInscripcion          Boolean
  requiereAprobacion           Boolean      @default(false)
  cupo                         Int?
  permiteListaEspera           Boolean      @default(false)
  costo                        Decimal?     @db.Decimal(10, 2)
  instruccionesPago            String?
  diasAnticipacionRecordatorio Int?
  // Ampliación 2026-10-09 (FR-060, D230): destinatarios con efecto. Edades en
  // años cumplidos al día del Evento; null = sin límite.
  destinatariosGenero          GeneroDestinatario @default(todas)
  edadMinima                   Int?
  edadMaxima                   Int?
  // FR-069 (D232): cuándo se borraron las respuestas sensibles (idempotencia).
  respuestasSensiblesBorradasEn DateTime?
  estado                       EstadoEvento @default(publicado)
  canceladoEn                  DateTime?
  canceladoPorId               String?
  eliminadoEn                  DateTime?
  eliminadoPorId               String?
  creadoPorId                  String
  createdAt                    DateTime     @default(now())
  updatedAt                    DateTime     @updatedAt

  inscripciones InscripcionEvento[]
  preguntas     PreguntaEvento[]

  @@index([estado, inicio])
  @@index([sedeId])
  @@index([tipo, inicio])
  @@index([eliminadoEn])
  @@map("eventos")
}

model InscripcionEvento {
  id                String                        @id @default(uuid())
  eventoId          String
  evento            Evento                        @relation(fields: [eventoId], references: [id])
  personaId         String
  persona           Persona                       @relation(fields: [personaId], references: [id])
  estado            EstadoInscripcionEvento
  createdAt         DateTime                      @default(now())
  // null = la propia Persona.
  creadoPorId       String?
  enListaDesde      DateTime?
  promovidaEn       DateTime?
  promocionVistaEn  DateTime?
  revisadoPorId     String?
  revisadoEn        DateTime?
  motivoRechazo     String?
  canceladaEn       DateTime?
  canceladaPorId    String?
  motivoCancelacion MotivoCancelacionInscripcion?
  // FR-062: el Admin la anotó con confirmación aunque no estaba entre los destinatarios.
  fueraDeDestinatarios Boolean                    @default(false)
  updatedAt         DateTime                      @updatedAt

  pagos             Pago[]
  respuestas        RespuestaPreguntaEvento[]
  solicitudBautismo SolicitudBautismo?

  @@index([eventoId, estado])
  @@index([personaId])
  @@index([eventoId, estado, enListaDesde])
  @@map("inscripciones_evento")
}

// --- spec 011, ampliación 2026-10-09: preguntas propias del Evento (D231, D232) ---

enum GeneroDestinatario {
  todas
  mujeres
  varones
}

enum TipoPreguntaEvento {
  si_no
  opcion
  texto
}

model PreguntaEvento {
  id          String             @id @default(uuid())
  eventoId    String
  evento      Evento             @relation(fields: [eventoId], references: [id], onDelete: Cascade)
  orden       Int
  texto       String
  tipo        TipoPreguntaEvento
  // Solo en `opcion`.
  opciones    String[]
  obligatoria Boolean            @default(false)
  // "Dato sensible (salud o alimentación)": solo lo ve `eventos.gestionar` y la
  // propia Persona; se borra 30 días después del Evento (FR-068, FR-069).
  sensible    Boolean            @default(false)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  respuestas RespuestaPreguntaEvento[]

  @@index([eventoId, orden])
  @@map("preguntas_evento")
}

// Las respuestas viven SOLO en la Inscripción a ese Evento, nunca en el perfil (D232).
model RespuestaPreguntaEvento {
  id            String            @id @default(uuid())
  inscripcionId String
  inscripcion   InscripcionEvento @relation(fields: [inscripcionId], references: [id], onDelete: Cascade)
  preguntaId    String
  pregunta      PreguntaEvento    @relation(fields: [preguntaId], references: [id], onDelete: Cascade)
  valor         String
  createdAt     DateTime          @default(now())

  @@unique([inscripcionId, preguntaId])
  @@index([preguntaId])
  @@map("respuestas_pregunta_evento")
}

model Pago {
  id                  String            @id @default(uuid())
  inscripcionEventoId String
  inscripcionEvento   InscripcionEvento @relation(fields: [inscripcionEventoId], references: [id])
  monto               Decimal           @db.Decimal(10, 2)
  medio               MedioPago
  fechaPago           DateTime          @db.Date
  // Área privada `comprobantes` (D168, D195).
  comprobanteRuta     String?
  comprobanteMime     String?
  estado              EstadoPago
  // null = la Persona; si es el Admin, nace `verificado`.
  creadoPorId         String?
  verificadoPorId     String?
  revisadoEn          DateTime?
  motivoRechazo       String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([inscripcionEventoId])
  @@index([estado, createdAt])
  @@map("pagos")
}

// --- spec 012: Notificaciones (D197–D206) ---

enum TipoNotificacion {
  manual
  automatica
}

enum PrioridadNotificacion {
  normal
  importante
}

enum AlcanceNotificacion {
  todos
  grupo
  ministerio
  evento
  persona
}

enum CanalEntrega {
  app
  email
  push // reservado (D149): ningún código lo produce todavía
}

enum EstadoEntrega {
  pendiente
  enviada
  fallida
}

// Solo la escribe `NotificacionesService` (apps/api/src/notificaciones/).
model Notificacion {
  id                String                @id @default(uuid())
  tipo              TipoNotificacion
  prioridad         PrioridadNotificacion
  alcance           AlcanceNotificacion
  alcanceId         String?
  // Solo automática: clave de CATALOGO_AVISOS (validada en código) y sus
  // parámetros (ids y datos no personales). El disparador se deriva (D198).
  evento            String?
  params            Json?
  entidadTipo       String?
  entidadId         String?
  // Solo manual.
  titulo            String?               @db.VarChar(80)
  mensaje           String?               @db.VarChar(1000)
  creadoPorId       String?
  creadoPor         Persona?              @relation("NotificacionesCreadas", fields: [creadoPorId], references: [id])
  claveIdempotencia String?               @unique
  createdAt         DateTime              @default(now())

  entregas EntregaNotificacion[]

  @@index([tipo, createdAt])
  @@index([creadoPorId])
  @@map("notificaciones")
}

model EntregaNotificacion {
  id               String        @id @default(uuid())
  notificacionId   String
  notificacion     Notificacion  @relation(fields: [notificacionId], references: [id])
  personaId        String
  persona          Persona       @relation(fields: [personaId], references: [id])
  canal            CanalEntrega
  estado           EstadoEntrega
  intentos         Int           @default(0)
  proximoIntentoEn DateTime?
  // Solo el TIPO de error (SIN_EMAIL, PERSONA_INACTIVA, ENVIO_FALLIDO).
  ultimoError      String?       @db.VarChar(64)
  enviadaEn        DateTime?
  leidaEn          DateTime?
  createdAt        DateTime      @default(now())

  @@unique([notificacionId, personaId, canal])
  @@index([personaId, canal, createdAt])
  @@index([canal, estado, proximoIntentoEn])
  @@index([notificacionId, canal, estado])
  @@map("entregas_notificacion")
}

// --- spec 013: Backoffice del Admin ---

enum TipoComentario {
  problema
  sugerencia
}

enum AppOrigen {
  web
  backoffice
}

// "Contanos qué te parece" (D102, D211). Sin borrado.
model ComentarioApp {
  id               String         @id @default(uuid())
  tipo             TipoComentario
  texto            String
  aceptaContacto   Boolean        @default(false)
  // Solo sin sesión y con aceptaContacto (CHECK).
  contactoEmail    String?
  contactoTelefono String?
  paginaOrigen     String
  navegador        String?
  ultimoRequestId  String?
  app              AppOrigen
  // HMAC de la IP (mecanismo de la 007); nunca la IP.
  origenHuella     String
  personaId        String?
  persona          Persona?       @relation("ComentariosDePersona", fields: [personaId], references: [id])
  revisadoEn       DateTime?
  revisadoPorId    String?
  revisadoPor      Persona?       @relation("ComentariosRevisados", fields: [revisadoPorId], references: [id])
  createdAt        DateTime       @default(now())

  @@index([revisadoEn, createdAt])
  @@index([origenHuella, createdAt])
  @@index([personaId, createdAt])
  @@index([revisadoPorId])
  @@map("comentarios_app")
}

// --- spec 014: Grupos de Extensión (D220–D228) ---

enum DiaSemana {
  lunes
  martes
  miercoles
  jueves
  viernes
  sabado
  domingo
}

enum EstadoSolicitudGrupoExtension {
  pendiente
  aceptada   // ES la pertenencia (D225, mismo criterio que D170)
  rechazada
  retirada
  finalizada // la quitó el Admin
}

// D221: el lugar es "En la iglesia" (la dirección de la Sede) o una dirección
// al estilo de La Plata. Las coordenadas se calculan al guardar (D223) y pueden
// faltar (el Grupo queda sin distancia). El género NO se guarda: sale de los
// líderes vigentes (D222). CHECK de forma en la migración `grupos_extension`.
model GrupoExtension {
  id           String      @id @default(uuid())
  nombre       String
  dias         DiaSemana[]
  // "HH:MM", en pasos de 15 minutos (CHECK).
  horaInicio   String
  cupo         Int?
  edadMinima   Int?
  edadMaxima   Int?
  enLaIglesia  Boolean     @default(false)
  sedeId       String?
  sede         Sede?       @relation(fields: [sedeId], references: [id])
  calle        String?
  numero       String?
  entreCalle1  String?
  entreCalle2  String?
  // Barrio o zona: lo único del lugar que ve quien todavía no es integrante (D224).
  zona         String?
  latitud      Float?
  longitud     Float?
  activo       Boolean     @default(true)
  creadoPorId  String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  lideres     LiderGrupoExtension[]
  solicitudes SolicitudGrupoExtension[]

  @@index([activo])
  @@map("grupos_extension")
}

// Un líder vigente tiene `hasta` en null (único parcial por Grupo y Persona).
model LiderGrupoExtension {
  id        String         @id @default(uuid())
  grupoId   String
  grupo     GrupoExtension @relation(fields: [grupoId], references: [id])
  personaId String
  persona   Persona        @relation(fields: [personaId], references: [id])
  desde     DateTime       @default(now())
  hasta     DateTime?

  @@index([grupoId])
  @@index([personaId])
  @@map("lideres_grupo_extension")
}

// D225: el pedido para sumarse. Una `pendiente` y una `aceptada` por Persona
// como máximo (índices únicos parciales en SQL).
model SolicitudGrupoExtension {
  id              String                        @id @default(uuid())
  personaId       String
  persona         Persona                       @relation(fields: [personaId], references: [id])
  grupoId         String
  grupo           GrupoExtension                @relation(fields: [grupoId], references: [id])
  estado          EstadoSolicitudGrupoExtension @default(pendiente)
  creadoPorId     String?
  revisadoPorId   String?
  revisadaEn      DateTime?
  // Mensaje opcional del líder (o del Admin) al decir "No es para este grupo".
  mensaje         String?
  retiradaEn      DateTime?
  finalizadaEn    DateTime?
  finalizadaPorId String?
  createdAt       DateTime                      @default(now())
  updatedAt       DateTime                      @updatedAt

  @@index([personaId])
  @@index([grupoId, estado])
  @@index([estado, createdAt])
  @@map("solicitudes_grupo_extension")
}
