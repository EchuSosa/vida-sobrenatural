# H-78/D124 (docs/05-decisiones.md): base propia para los e2e de Playwright de
# apps/web y apps/backoffice — nunca la de desarrollo. Copiá este archivo a
# `.env.e2e` antes de correr los e2e (ver docs/11-setup-local.md);
# scripts/e2e-base-datos.cjs la crea y siembra sola.
DATABASE_URL="postgresql://vidasobrenatural:vidasobrenatural_dev@localhost:5432/vidasobrenatural_e2e?schema=public"

# No necesitan ser secretos reales — nunca se usan contra Google real, solo
# entre la API de e2e y las instancias de e2e de apps/web/apps/backoffice
# (mismo valor en las tres, como en dev).
NEXTAUTH_SECRET="e2e-secret"
INTERNAL_API_SECRET="e2e-internal"

# Carpeta separada de la de dev (./storage/portadas) — los e2e de Libros suben
# portadas de verdad (H-94), y no tiene sentido que esos archivos de prueba
# convivan con los de desarrollo.
STORAGE_DIR="./storage/portadas-e2e"
