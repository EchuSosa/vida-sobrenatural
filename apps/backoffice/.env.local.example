# URL pública de esta app (usada por NextAuth.js para construir el callback URL)
NEXTAUTH_URL="http://localhost:3002"

# Debe ser el mismo valor en apps/api y apps/web.
NEXTAUTH_SECRET="changeme-generate-with-openssl-rand-base64-32"

# Debe ser el mismo valor en apps/api y apps/web — llamada servidor-a-servidor a GET /personas/by-email.
INTERNAL_API_SECRET="changeme-generate-with-openssl-rand-base64-32"

# Credenciales de Google OAuth (Google Cloud Console > APIs & Services > Credentials).
# Nombres exactos: Auth.js v5 los auto-detecta por convención (AUTH_<PROVIDER>_ID/_SECRET).
AUTH_GOOGLE_ID="changeme"
AUTH_GOOGLE_SECRET="changeme"

# Base URL de apps/api desde el servidor de esta app (Server Components, NextAuth callbacks).
API_BASE_URL="http://localhost:3333"

# Misma base URL, pero accesible desde el navegador (páginas cliente como /sedes, /pendientes-tutor).
NEXT_PUBLIC_API_BASE_URL="http://localhost:3333"

# Opcional — monitoreo de errores (D101, H-112). @sentry/nextjs ya está instalado y queda inerte
# sin DSN (Sentry.init no envía nada si dsn es undefined). Descomentar y completar con el DSN real
# recién cuando exista hosting con Sentry configurado — ver docs/10-stack-tecnico.md.
# NEXT_PUBLIC_SENTRY_DSN="https://changeme@oXXXXXX.ingest.sentry.io/XXXXXXX"
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"

# URL pública de apps/web (specs 011 y 013): el QR y el enlace de cada Evento, y
# "ver en la app". Una sola variable para todo el backoffice (lote 0 global).
NEXT_PUBLIC_WEB_APP_URL="http://localhost:3001"
