{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": [".next/**", "!.next/cache/**"],
      "env": [
        "NEXT_PUBLIC_API_BASE_URL",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_ENVIRONMENT",
        "SENTRY_AUTH_TOKEN"
      ]
    },
    "typecheck": {
      "description": "Mismo motivo que apps/web/turbo.json: Next.js genera LayoutProps/PageProps recién con un build propio de esta app.",
      "dependsOn": ["^build", "build"]
    }
  }
}
